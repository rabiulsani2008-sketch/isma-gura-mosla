# ============================================================
# ইসমা গুড়া মসলা প্রাইভেট লিমিটেড - Environment Configuration
# ============================================================

# --- DATABASE ---
# For LOCAL DEV (SQLite — no setup needed, works out of the box):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# For PRODUCTION (Supabase — see SETUP.md for step-by-step guide):
# 1. Create free account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings → Database → Connection string → URI
# 4. Copy it here (replace YOUR_PASSWORD and YOUR_PROJECT_REF):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# 5. Run: bash scripts/setup-db.sh
# 6. Restart the app

# --- SUPABASE (optional, for file storage / real-time) ---
# Get these from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
