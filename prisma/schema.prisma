// ইসমা গুড়া মসলা প্রাইভেট লিমিটেড - Database Schema
// Bangla-first spice business management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Authentication & Shop =====

model Shop {
  id          String   @id @default(cuid())
  name        String
  ownerName   String
  phone       String
  address     String
  logoUrl     String?
  currency    String   @default("৳")
  tagline     String   @default("গুণগত মান, বিশ্বাস আমাদের")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  categories  Category[]
  products    Product[]
  customers   Customer[]
  suppliers   Supplier[]
  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]
  payments    Payment[]
  stockMovements StockMovement[]
  transactions   Transaction[]
}

model User {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  pin       String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, phone])
}

// ===== Catalog =====

model Category {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  products  Product[]

  @@unique([shopId, name])
}

model Product {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  unit           String   @default("kg")
  purchasePrice  Float    @default(0)
  sellingPrice   Float    @default(0)
  stockQuantity  Float    @default(0)
  minimumStock   Float    @default(0)
  imageUrl       String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@unique([shopId, name])
}

// ===== People =====

model Customer {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  address     String?
  openingDue  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]
  payments    Payment[]
}

model Supplier {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  address     String?
  openingDue  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   Purchase[]
  payments    Payment[]
}

// ===== Sales =====

model Sale {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceNumber String
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  dueAmount     Float    @default(0)
  paymentMethod String   @default("নগদ")
  saleDate      DateTime @default(now())
  createdAt     DateTime @default(now())

  items         SaleItem[]
  transactions  Transaction[]
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitPrice  Float
  costPrice  Float // snapshot at time of sale — required for profit calc
  total      Float
}

// ===== Purchases =====

model Purchase {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String
  totalAmount   Float     @default(0)
  paidAmount    Float     @default(0)
  dueAmount     Float     @default(0)
  paymentMethod String    @default("নগদ")
  purchaseDate  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  items         PurchaseItem[]
  transactions  Transaction[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitPrice  Float
  total      Float
}

// ===== Expenses =====

model Expense {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  note        String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  transactions Transaction[]
}

// ===== Payments (customer_payment / supplier_payment) =====

model Payment {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  amount        Float
  type          String    // customer_payment | supplier_payment
  paymentMethod String    @default("নগদ")
  note          String?
  paymentDate   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  transactions  Transaction[]
}

// ===== Stock Movements =====

model StockMovement {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   // purchase | sale | adjustment | return
  quantity    Float    // positive for in, negative for out
  reference   String?
  createdAt   DateTime @default(now())
}

// ===== Unified Transaction Ledger =====

model Transaction {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type          String   // sale | purchase | expense | customer_payment | supplier_payment
  referenceId   String?
  saleId        String?
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  expenseId     String?
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  description   String
  amount        Float
  paymentMethod String?
  createdAt     DateTime @default(now())
}
